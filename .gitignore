# Environment
.env
.env.local

# Local signing keys and other generated secrets. Listed explicitly rather than
# left to the *.pem rule below, so that adding a secret in another format cannot
# quietly become committable.
.secrets/

# Backend (Go)
backend/tmp/
backend/api
backend/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# Frontend (Node)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.turbo/
frontend/src/lib/api.generated.ts

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# OS
Thumbs.db

# Certificates
*.pem
*.crt
*.key
