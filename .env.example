# MiniClass local development environment.
#
# Copy this file to .env with ./scripts/setup.sh, which never overwrites an
# existing .env. This is the only .env in the repository; there is no
# frontend/.env.
#
# INVARIANT: no value may contain whitespace or the '#' character.
#
# This file is read by three parsers that disagree about quoting: GNU Make's
# "-include ../.env" in backend/Makefile, POSIX "." sourcing in scripts/, and
# godotenv in internal/config. A POSIX shell needs a spaced value quoted, Make
# makes the quotes part of the value, and Make treats '#' as a comment where a
# shell does not. Only an unquoted value containing neither whitespace nor '#' is
# read identically by all three. Values that cannot satisfy that, such as a PEM
# key, live in a file under .secrets/ and are referenced here by path.
#
# See docs/adr/0011-local-development-orchestration-and-environment-contract.md.

# Application
APP_ENV=development
APP_VERSION=0.1.0

# Backend API
PORT=8080
API_BASE_URL=http://localhost:8080
INVITATION_CLAIM_BASE_URL=http://localhost:5173/claim
# Comma-separated CIDRs for reverse proxies allowed to supply client IP headers.
# Leave empty when the API is directly exposed.
TRUSTED_PROXY_CIDRS=

# Frontend
VITE_PORT=5173
# The client bundle's API base URL, read as import.meta.env.VITE_API_URL. Empty
# in local development, so the browser requests a relative /api and travels
# through the Vite dev proxy below. That keeps the API same-origin and lets the
# Content-Security-Policy in frontend/index.html keep connect-src at 'self'.
VITE_API_URL=
# Where the Vite dev server forwards /api, read as process.env.API_PROXY_TARGET
# in frontend/vite.config.ts. Node side only; never exposed to the browser.
API_PROXY_TARGET=http://localhost:8080

# Browser authentication. The anon key value localdevkey selects the local
# fake-auth client in frontend/src/lib/auth.ts, which never contacts Supabase and
# takes its session from VITE_DEV_TOKEN. Any other non-empty value creates a real
# Supabase client against VITE_SUPABASE_URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=localdevkey
# A locally signed bearer token from cmd/devtoken. Leave empty to start
# unauthenticated.
VITE_DEV_TOKEN=

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=miniclass
POSTGRES_PASSWORD=miniclass_dev_password
POSTGRES_DB=miniclass
POSTGRES_TEST_DB=miniclass_test

# Database URLs: DATABASE_URL is migrator-only; the API, seed, and bootstrap use APP_DATABASE_URL.
DATABASE_URL=postgres://miniclass_migrator:miniclass_migrator_dev_password@localhost:5432/miniclass?sslmode=disable
APP_DATABASE_URL=postgres://miniclass_app:miniclass_app_dev_password@localhost:5432/miniclass?sslmode=disable
TEST_DATABASE_URL=postgres://miniclass_migrator:miniclass_migrator_dev_password@localhost:5432/miniclass_test?sslmode=disable
TEST_APP_DATABASE_URL=postgres://miniclass_app:miniclass_app_dev_password@localhost:5432/miniclass_test?sslmode=disable
POSTGRES_ADMIN_DATABASE_URL=postgres://miniclass:miniclass_dev_password@localhost:5432/postgres?sslmode=disable

# The migration round-trip gate (`make test-migrations`, and gate 5 of
# `make check`) creates and drops its own scratch database, so these never point
# at a database that holds anything. The rollback runs as the superuser because a
# down migration may need to drop an object the migrator does not own.
MIGRATION_ROUNDTRIP_DATABASE_URL=postgres://miniclass_migrator:miniclass_migrator_dev_password@localhost:5432/miniclass_migration_roundtrip?sslmode=disable
MIGRATION_ROUNDTRIP_ADMIN_DATABASE_URL=postgres://miniclass:miniclass_dev_password@localhost:5432/miniclass_migration_roundtrip?sslmode=disable

# Supabase (leave empty for local dev, populate for production)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# API bearer-token verification. Local uses an ES256/RS256 public key; use
# cmd/devtoken with the matching private key to mint a development token.
AUTH_PROVIDER=local
AUTH_ISSUER=http://localhost:8080
AUTH_AUDIENCE=authenticated
AUTH_LOCAL_KEY_ID=local
# Signing keys as files, generated into .secrets/ by ./scripts/setup.sh. A
# relative path resolves against the process working directory, and backend
# commands run from backend/, so these point one level up to the repository root.
AUTH_LOCAL_PUBLIC_KEY_FILE=../.secrets/local_auth_public.pem
AUTH_LOCAL_PRIVATE_KEY_FILE=../.secrets/local_auth_private.pem
# Inline PEM fallbacks, used only when the *_FILE variables above are empty. A
# PEM header contains spaces, so these cannot satisfy the invariant at the top of
# this file. Leave them empty for local development.
AUTH_LOCAL_PUBLIC_KEY=
AUTH_LOCAL_PRIVATE_KEY=

# Adult authentication. MFA secrets are encrypted with this key; SMTP fields
# enable transactional guardian OTP delivery. Leave SMTP empty to disable the
# flow in a local environment.
AUTH_MFA_ENCRYPTION_KEY=
AUTH_SMTP_ADDRESS=
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=

# Local development
# The Owner the seed data invites, and the address to log in as locally.
DEV_ADMIN_EMAIL=owner@example.test

# Optional: Database GUI
ADMINER_PORT=8081
