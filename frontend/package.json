{
  "name": "miniclass-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/lib/api.generated.ts",
    "dev": "bun run generate:api && sh -c 'set -a; if [ -f ../.env ]; then . ../.env; fi; set +a; exec bunx --bun vite --port ${VITE_PORT:-5173} \"$@\"' --",
    "build": "bun run generate:api && bunx --bun tsc && bunx --bun vite build",
    "format": "bunx --bun biome format --write .",
    "format:check": "bunx --bun biome format .",
    "lint": "bun run format:check && bunx --bun eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "bunx --bun vite preview",
    "test": "bun run generate:api && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "2.112.4",
    "@tanstack/react-query": "^5.28.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "openapi-fetch": "^0.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@biomejs/biome": "2.5.5",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^24.1.1",
    "openapi-typescript": "^7.9.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  }
}
